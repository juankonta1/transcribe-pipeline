# transcribe-pipeline config
# Hugging Face token (needed for speaker diarization).
# Get one free: https://huggingface.co/settings/tokens (read access)
# Also accept terms at:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Whisper model: large-v3-turbo (fast) or large-v3 (slightly better Spanglish)
MODEL=large-v3-turbo

# Diarization model. Requires accepting terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# (pyannote.audio 4.x pulls files from this repo even for the older 3.1 pipeline)
DIARIZE_MODEL=pyannote/speaker-diarization-community-1

# auto = detect language; or force with es / en
LANGUAGE=auto

# Where transcripts land
OUTPUT_DIR=/Users/juan_/Vibecoding/Transcripts

# true = automatically run claude cleanup pass on every transcript
CLEAN=false
